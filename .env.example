# EvRAG环境变量配置示例
# 复制此文件为 .env 并根据实际情况修改

# 基础路径（可选，默认使用当前目录）
# BASE_DIR=/path/to/project

# LLM配置
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL_NAME=qwen3_lora_sft_int4

# MongoDB配置
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DATABASE=evrag

# 服务配置
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# 模型路径（可选，如果不在默认位置）
# BGE_M3_MODEL_PATH=/path/to/bge-m3
# QWEN3_EMBEDDING_MODEL_PATH=/path/to/qwen3-embedding