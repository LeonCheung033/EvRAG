# EvRAG 环境变量配置示例
# 复制此文件为 .env 并根据实际情况修改
# 
# 使用方法：
#   cp .env.example .env
#   然后编辑 .env 填入你的实际配置
#
# 注意：环境变量的优先级高于 config/config.yaml 中的配置
# 配置优先级：环境变量 > YAML配置文件 > 默认值

# ========== 基础路径配置 ==========
# BASE_DIR=.  # 项目根目录（默认使用当前工作目录）

# ========== API密钥配置 ==========
# 这些密钥也可以通过 config/config.yaml 配置，但使用环境变量更安全

# 豆包API配置（用于文档清洗等）
# 请访问 https://console.volcengine.com/ark 获取API密钥和接入点ID
DOUBAO_API_KEY=YOUR_DOUBAO_API_KEY
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL_NAME=YOUR_DOUBAO_ENDPOINT_ID

# Deepseek API配置（用于生成问答数据）
# 请访问 https://platform.deepseek.com 获取API密钥
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_NAME=deepseek-chat

# SiliconFlow API配置（用于Reranker数据生成和评估）
# 请访问 https://siliconflow.cn 获取API密钥
SILICONFLOW_API_KEY=YOUR_SILICONFLOW_API_KEY
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_RERANKER_MODEL=Qwen/Qwen3-Reranker-8B

# ========== LLM服务配置 ==========
# 本地vLLM服务配置（基线模型，端口8000）
LOCAL_LLM_MODEL_NAME=Qwen3-8B
LOCAL_LLM_BASE_URL=http://localhost:8000/v1
LOCAL_LLM_API_KEY=EMPTY

# 微调模型vLLM服务配置（端口8001）
FINETUNED_LLM_MODEL_NAME=qwen3_lora_sft
FINETUNED_LLM_BASE_URL=http://localhost:8001/v1
FINETUNED_LLM_API_KEY=EMPTY

# 兼容旧配置（向后兼容）
# LLM_MODEL_NAME=qwen3_lora_sft_int4
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_API_KEY=EMPTY

# ========== MongoDB配置 ==========
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DATABASE=evrag

# ========== 服务配置 ==========
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SEMANTIC_CHUNK_URL=http://0.0.0.0:6000/v1/semantic-chunks

# ========== GPU设备分配配置 ==========
# 根据你的GPU数量和显存情况调整以下配置
SEMANTIC_CHUNK_GPU_ID=0
MILVUS_RETRIEVER_GPU_ID=1
RERANKER_GPU_ID=2
# VLLM_GPU_IDS=3,4  # 注意：列表类型的环境变量可能需要特殊处理

# ========== PDF解析配置 ==========
PDF_MIN_FILTER_PAGES=4
PDF_MAX_FILTER_PAGES=247
PDF_PAGE_CLIP=50

# ========== 设备配置 ==========
DEVICE=cuda
